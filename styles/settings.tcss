/* ========================================================================= */
/* ВКЛАДКА «НАЛАШТУВАННЯ» */
/* ========================================================================= */

SettingsTab {
    height: 1fr;
    width: 1fr;
    padding: 1;
    background: $background;
}

#settings-root {
    height: 1fr;
    width: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

#settings-top-row {
    height: auto;
    width: 1fr;
    margin-bottom: 0;
    align: left top;
}

#settings-password-box,
#settings-global-box,
#settings-logo-box {
    height: auto;
    width: 1fr;
    border: none;
    background: transparent;
    padding: 0 1;
    margin-bottom: 1;
}

#settings-password-box {
    width: 55%;
    min-width: 32;
    margin-right: 1;
    margin-bottom: 1;
}

#settings-logo-box {
    width: 45%;
    min-width: 28;
}

.settings-section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.settings-row {
    height: auto;
    width: 1fr;
    margin-bottom: 0;
    align: left middle;
}

.settings-row > Input {
    width: 1fr;
    min-width: 12;
    margin-right: 1;
    margin-bottom: 1;
}

.settings-row > Select {
    width: 1fr;
    min-width: 18;
    margin-right: 1;
}
