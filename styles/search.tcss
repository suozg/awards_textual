/* ========================================================================= */
/* ВКЛАДКА ПОИСК */
/* ========================================================================= */

SearchTab {
    height: 1fr;
}

#search-toolbar {
    height: 3;
    min-height: 3;
    margin-bottom: 1;
}

#search-body {
    height: 1fr;
    min-height: 0;
}

#search-results-scroll {
    height: 1fr;
    min-height: 0;
    margin-bottom: 1;
}

#search-results {
    height: auto;
}

#search-images {
    layout: horizontal;
    height: 10;
    width: 1fr;
    overflow-x: auto;
    overflow-y: hidden;
}

.search-award-image-card {
    width: 20;
    min-width: 20;
    height: 9;
    align: center top;
}

.award-image {
    width: 18;
    height: 8;
}
